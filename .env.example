# =============================================================================
# Copie este arquivo para .env.local (na raiz) e preencha os valores.
# NUNCA comite o .env.local — ele esta no .gitignore.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servico. NUNCA exponha no navegador nem prefixe com NEXT_PUBLIC_.
# Usada apenas pelo bot e por rotas de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram -----------------------------------------------------------------
# Token gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=
# Segredo qualquer (ex: openssl rand -hex 32). O Telegram devolve esse valor no
# header X-Telegram-Bot-Api-Secret-Token e nos validamos antes de processar.
TELEGRAM_WEBHOOK_SECRET=
# Username do bot, sem o @ (ex: atria_prospeccao_bot). Usado no painel para
# montar o deep link de vinculo da conta do Telegram.
TELEGRAM_BOT_USERNAME=

# --- E-mail (Resend) ----------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
# Precisa ser de um dominio verificado no Resend.
# Em desenvolvimento da para usar onboarding@resend.dev
EMAIL_REMETENTE=Atria EJ <prospeccao@suaej.com.br>

# --- Casa dos Dados (opcional) ------------------------------------------------
# API paga por consulta. Sem esta chave, a tela de busca por regiao/setor exibe
# um aviso de "integracao nao configurada" e o resto do sistema segue normal.
CASA_DOS_DADOS_API_KEY=

# --- App ----------------------------------------------------------------------
# URL publica do painel (usada em links de e-mail). Em dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
